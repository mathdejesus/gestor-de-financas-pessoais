# Backend Environment Variables
# NEVER commit .env files to version control

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/financial_platform
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# JWT Security (REQUIRED)
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=financeapp

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# HikariCP Pool
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5

# Management
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
