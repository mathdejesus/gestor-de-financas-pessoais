# =============================================================================
# FinanceApp Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =============================================================================

# --- Database ---
POSTGRES_DB=financial_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- JWT Security ---
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# --- Spring Profile ---
# prod = PostgreSQL + Flyway migrations (usado pelo docker compose — padrão)
# dev  = H2 in-memory (ddl-auto create-drop, Flyway disabled) — apenas sem Docker
SPRING_PROFILES_ACTIVE=prod
